{
  "name": "poker-trainer",
  "version": "1.0.0",
  "description": "Poker trainer backend",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx --no-warnings --watch src/index.ts",
    "start:prod": "node dist/src/index.js",
    "train": "tsx src/run-train.ts",
    "test": "pnpm test:run",
    "test:run": "pnpm build && node --test 'dist/tests/**/*.test.js'",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "poker",
    "trainer"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "typescript-eslint": "^8.56.1"
  }
}
